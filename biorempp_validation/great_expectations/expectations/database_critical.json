{
  "name": "database_critical",
  "expectations": [
    {
      "type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "cpd",
          "compoundclass",
          "ko",
          "referenceAG",
          "compoundname",
          "genesymbol",
          "genename",
          "enzyme_activity"
        ]
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 1
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_compound_columns_to_be_unique",
