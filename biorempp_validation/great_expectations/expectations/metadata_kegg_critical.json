        "min_value": 1,
        "max_value": 1
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "release_text"
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "parsed_version"
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "retrieved_at_utc"
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "source_url"
      },
      "severity": "critical",
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
